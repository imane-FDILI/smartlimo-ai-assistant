# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored — never commit it.

# PostgreSQL connection string (Neon). Get it from the Neon dashboard:
# Project -> Connection Details -> "Pooled connection" or "Direct connection".
# Must include sslmode=require for Neon.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Gmail account used to send reservation confirmation emails
# (app/services/email_service.py). SMTP_PASSWORD must be a Gmail
# "App Password" (Google Account -> Security -> 2-Step Verification ->
# App passwords), NOT your normal Gmail login password.
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Optional: where internal "new reservation" notifications are sent.
# Defaults to SMTP_USER if not set.
ADMIN_NOTIFICATION_EMAIL=team@example.com

# Optional: port the API listens on. Only used by Docker/Railway-style
# platforms (see Dockerfile CMD). uvicorn --reload locally ignores this;
# pass --port explicitly on the command line instead.
PORT=8000
